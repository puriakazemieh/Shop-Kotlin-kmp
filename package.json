{
  "name": "carmilla-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Carmilla PWA end-to-end test harness",
  "scripts": {
    "test:e2e": "npm run test:e2e:prepare-pwa && playwright test --config=playwright.config.cjs",
    "test:e2e:fake": "npm run test:e2e:prepare-pwa && playwright test --config=playwright.config.cjs --project=fake-desktop --project=fake-mobile",
    "test:e2e:prepare-pwa": "node tests/e2e/prepare-pwa.cjs",
    "test:e2e:list": "playwright test --config=playwright.config.cjs --list"
  },
  "devDependencies": {
    "@playwright/test": "1.48.0"
  }
}
